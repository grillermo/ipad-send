{
  "manifest_version": 3,
  "name": "Send to iPad",
  "version": "1.0.0",
  "description": "Send the current page to the iPad reader.",
  "icons": { "128": "icon.png" },
  "permissions": ["scripting", "storage", "notifications", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Send to iPad" },
  "options_page": "options.html",
  "commands": {
    "send-to-ipad": {
      "suggested_key": { "default": "Alt+Shift+I" },
      "description": "Send current page to iPad"
    }
  }
}
